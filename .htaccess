# ==============================================================================
# SND MEDIA — APACHE WEB SERVER CONFIGURATION
# ==============================================================================

# 1. Disable Directory Listing
Options -Indexes

# 2. Character Set
AddDefaultCharset UTF-8

# 2.1. Gzip / Deflate Output Compression (70-80% Bandwidth & Latency Reduction)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 3. Security HTTP Response Headers & Footprint Masking
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"

    # Conceal Backend Technology Footprint
    Header unset X-Powered-By
    Header always unset X-Powered-By
    Header unset Server
    Header always unset Server

    # Static Asset Caching for high-performance delivery (1 hour cache)
    <FilesMatch "\.(css|js|png|jpg|jpeg|webp|svg|ico|woff|woff2|ttf)$">
        Header set Cache-Control "max-age=3600, public"
    </FilesMatch>
</IfModule>

<IfModule mod_php.c>
    php_flag expose_php Off
</IfModule>
<IfModule mod_php7.c>
    php_flag expose_php Off
</IfModule>
<IfModule mod_php8.c>
    php_flag expose_php Off
</IfModule>

# 4. Error Document Handlers
ErrorDocument 404 /Websites/SND-Media-House/404.php

# 5. Block Direct Access to Sensitive Files & Folders
<FilesMatch "(\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist|env)|composer\.(json|lock))$">
    Order deny,allow
    Deny from all
</FilesMatch>

# 6. URL Rewriting Engine (Clean Extensionless Routing)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /Websites/SND-Media-House/

    # 6.1. Redirect direct .php requests to clean extensionless URLs (exclude internal / api endpoints if needed)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/Websites/SND-Media-House/([^\s?]+)\.php [NC]
    RewriteRule ^ %1 [R=301,L,NE]

    # 6.2. Sitemap Routing
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # 6.3. Clean Legal Policy Pages: /legal/privacy-policy -> legal.php?page=privacy-policy
    RewriteRule ^legal/([a-z0-9-]+)/?$ legal.php?page=$1 [L,QSA]

    # 6.4. Clean Article URLs: /article/slug-title -> article.php?slug=slug-title
    RewriteRule ^article/([a-z0-9-]+)/?$ article.php?slug=$1 [L,QSA]

    # 6.5. Clean Category URLs: /category/national -> index.php?cat=national
    RewriteRule ^category/([a-z0-9-]+)/?$ index.php?cat=$1 [L,QSA]

    # 6.6. Map Extensionless URLs to .php files if file exists
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/Websites/SND-Media-House/$1.php -f [OR]
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.php [L,QSA]

    # 6.7. Map Extensionless Subdirectory URLs (e.g. admin/login -> admin/login.php)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ $1/$2.php [L,QSA]
</IfModule>
