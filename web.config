<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- 1. Block Direct Web Access to Sensitive Directories, Files & Uploaded PHP -->
        <rule name="Block Sensitive Paths" stopProcessing="true">
          <match url="^(config|database|includes)(/.*)?$|^assets/uploads/.*\.php$|^(\.git|\.htaccess|\.env)|(\.(bak|sql|fla|psd|ini|log|sh|inc|swp|dist|env)|composer\.(json|lock))$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Access Denied" />
        </rule>

        <!-- 2. Dynamic XML Sitemap Routing -->
        <rule name="Sitemap XML" stopProcessing="true">
          <match url="^sitemap\.xml$" ignoreCase="true" />
          <action type="Rewrite" url="sitemap.php" />
        </rule>

        <!-- 3. Clean Legal Policy URLs: /legal/privacy-policy -> legal.php?page=privacy-policy -->
        <rule name="Clean Legal URLs" stopProcessing="true">
          <match url="^legal/([a-z0-9-]+)/?$" ignoreCase="true" />
          <action type="Rewrite" url="legal.php?page={R:1}" appendQueryString="true" />
        </rule>

        <!-- 4. Clean Article URLs: /article/slug-title -> article.php?slug=slug-title -->
        <rule name="Clean Article URLs" stopProcessing="true">
          <match url="^article/([a-z0-9-]+)/?$" ignoreCase="true" />
          <action type="Rewrite" url="article.php?slug={R:1}" appendQueryString="true" />
        </rule>

        <!-- 5. Clean Category URLs: /category/national -> index.php?cat=national -->
        <rule name="Clean Category URLs" stopProcessing="true">
          <match url="^category/([a-z0-9-]+)/?$" ignoreCase="true" />
          <action type="Rewrite" url="index.php?cat={R:1}" appendQueryString="true" />
        </rule>

        <!-- 6a. Extensionless Root PHP URLs: /studio-rental -> studio-rental.php -->
        <rule name="Extensionless Root PHP" stopProcessing="true">
          <match url="^([a-zA-Z0-9_-]+)$" ignoreCase="true" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_FILENAME}.php" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.php" appendQueryString="true" />
        </rule>

        <!-- 6b. Extensionless Root PHP URLs with trailing slash: /studio-rental/ -> studio-rental.php -->
        <rule name="Extensionless Root PHP Trailing Slash" stopProcessing="true">
          <match url="^([a-zA-Z0-9_-]+)/$" ignoreCase="true" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{APPL_PHYSICAL_PATH}{R:1}.php" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.php" appendQueryString="true" />
        </rule>

        <!-- 7a. Extensionless Subdirectory PHP URLs: /admin/login -> admin/login.php -->
        <rule name="Extensionless Subdirectory PHP" stopProcessing="true">
          <match url="^([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)$" ignoreCase="true" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_FILENAME}.php" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}/{R:2}.php" appendQueryString="true" />
        </rule>

        <!-- 7b. Extensionless Subdirectory PHP URLs with trailing slash: /admin/login/ -> admin/login.php -->
        <rule name="Extensionless Subdirectory PHP Trailing Slash" stopProcessing="true">
          <match url="^([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/$" ignoreCase="true" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{APPL_PHYSICAL_PATH}{R:1}\{R:2}.php" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}/{R:2}.php" appendQueryString="true" />
        </rule>

        <!-- 8. Branded 404 Fallback (avoids locked <httpErrors> section on shared PleskWin IIS) -->
        <rule name="Custom 404 Fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{URL}" pattern="\.(css|js|png|jpg|jpeg|gif|webp|svg|ico|woff|woff2|ttf|map|pdf|txt|xml)$" negate="true" />
          </conditions>
          <action type="Rewrite" url="404.php" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
